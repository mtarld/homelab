#define WALLPAPER ~/.config/regolith3/wallpaper.jpg
#define FONT Agave Nerd Font Mono 15

gtk.document_font_name: FONT
gtk.font_name: FONT
wm.bar.font: FONT
wm.font: FONT

gtk.monospace_font_name: FONT
gnome.terminal.font: FONT

gtk.theme_name: Adwaita

regolith.wallpaper.file: WALLPAPER
regolith.wallpaper.options: zoom
regolith.lockscreen.wallpaper.file: WALLPAPER
regolith.lockscreen.wallpaper.options: zoom

wm.gaps.inner.size: 30
wm.program.unclutter: :
wm.bar.trayoutput: none
wm.window.border.size: 2

## do not update default terminal theme during regolith-look regresh
gnome.terminal.update: false

## Remap dec_gaps otherwise it is colliding with moving a window to the 6th workspace
wm.binding.dec_gaps: minus
wm.binding.dec_gaps_big: Shift+minus

## Remap vertical and horizontal window orientation
wm.binding.split_h: semicolon
wm.binding.split_v: apostrophe

## Remap sleep to avoid unexpected sleep trigger
wm.binding.sleep: Shift+o

wm.workspace.01.name: 1
wm.workspace.02.name: 2
wm.workspace.03.name: 3
wm.workspace.04.name: 4
wm.workspace.05.name: 5
wm.workspace.06.name: 6
wm.workspace.07.name: 7
wm.workspace.08.name: 8
wm.workspace.09.name: 9
wm.workspace.10.name: 10
wm.workspace.11.name: 11
wm.workspace.12.name: 12
wm.workspace.13.name: 13
wm.workspace.14.name: 14
wm.workspace.15.name: 15
wm.workspace.16.name: 16
wm.workspace.17.name: 17
wm.workspace.18.name: 18
wm.workspace.19.name: 19

i3xrocks.value.font: FONT

wm.program.terminal: wezterm

! Bar
wm.bar.position: top
wm.bar.background.color: #22272E
wm.bar.statusline.color: #768390
wm.bar.separator.color: #22272E
wm.bar.workspace.focused.border.color: #2D333B
wm.bar.workspace.focused.background.color: #2D333B
wm.bar.workspace.focused.text.color: #ADBAC7
wm.bar.workspace.active.border.color: #ADBAC7
wm.bar.workspace.active.background.color: #ADBAC7
wm.bar.workspace.active.text.color: #22272E
wm.bar.workspace.inactive.border.color: #22272E
wm.bar.workspace.inactive.background.color: #22272E
wm.bar.workspace.inactive.text.color: #768390
wm.bar.workspace.urgent.border.color: #F47067
wm.bar.workspace.urgent.background.color: #F47067
wm.bar.workspace.urgent.text.color: #ADBAC7

! Window borders
wm.client.focused.color.child_border: #D0B46F
